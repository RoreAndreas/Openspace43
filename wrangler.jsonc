// La configuration Cloudflare de l'open space.
// Secrets à ajouter dans Cloudflare (Workers → openspace → Settings → Variables and Secrets) :
//   ACCESS_CODE  le code d'accès au bureau (obligatoire)
//   TAVILY_KEY   facultatif : une clé Tavily (la recherche de Rook, et une recherche web plus fiable) ; CLE_TAVILY marche aussi
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openspace43",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // construit le bureau (dossier dist) avant chaque mise en ligne, même si Cloudflare ne lance que « wrangler deploy »
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  // la base 43 WACC de Hares : la page publiée de WACC43
  "vars": { "WACC43_URL": "https://43wacc.pages.dev/" },
  "observability": { "enabled": false }
}
