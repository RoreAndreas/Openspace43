// La configuration Cloudflare de l'open space.
// Secrets à ajouter dans Cloudflare (Workers → openspace → Settings → Variables and Secrets) :
//   ACCESS_CODE  le code d'accès au bureau (obligatoire)
//   TAVILY_KEY   facultatif : une clé Tavily pour une recherche web plus fiable
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openspace43",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "observability": { "enabled": false }
}
